# StocksIntels Hetzner deploy .env
# Copy this file to .env and fill in your values. Never commit .env.

# --- Postgres (db service) ---
POSTGRES_USER=stockintel
POSTGRES_DB=stockintel
POSTGRES_PASSWORD=<strong-db-password>

# --- JWT ---
JWT_SECRET=<strong-random-string>

# --- Azure AI Foundry (position intelligence) ---
AZURE_AI_ENABLED=true
AZURE_AI_ENDPOINT=https://stocksintels-foundry.services.ai.azure.com/api/projects/stocksintels/openai/v1
AZURE_AI_API_KEY=<your-rotated-key>
AZURE_AI_MODEL=gpt-5-mini

# --- URLs / CORS ---
CORS_ORIGIN=https://stockintels.vercel.app
FRONTEND_URL=https://stockintels.vercel.app
APP_URL=https://stocksintels.com

# --- Optional API keys (leave blank if not used) ---
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Payments (optional) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
BACHS_API_KEY=

# --- Email (optional) ---
# Preferred providers can be stored in ../resend.env (loaded by Compose):
RESEND_API_KEY=
RESEND_FROM=StocksIntels <noreply@stocksintels.com>
ENSEND_PROJECT_SECRET=
ENSEND_SENDER_ADDRESS=
ENSEND_SENDER_NAME=StocksIntels
# SMTP is the fallback provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Rate scraping (optional) ---
FUND_SCRAPE_PROXY=
