# Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email Provider: 'sendgrid' or 'smtp'
EMAIL_PROVIDER=sendgrid

# ============================================
# SENDGRID CONFIGURATION (Recommended)
# ============================================
# Get your API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=billing@leadflow.ai
SENDGRID_REPLY_TO=support@leadflow.ai

# ============================================
# SMTP CONFIGURATION (Alternative)
# ============================================
# For Gmail: use app-specific password (https://myaccount.google.com/apppasswords)
# For custom SMTP: use your provider's SMTP settings
SMTP_SERVICE=gmail
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_REPLY_TO=support@leadflow.ai

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string (preferred)
DATABASE_URL=postgres://postgres:password@localhost:5432/leadai

# Alternatively set each Postgres parameter below
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=leadai
PGSSLMODE=disable

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================
# Provider: 'openai', 'claude', or 'rule' (industry-aware templates, no API key needed)
AI_PROVIDER=rule

# OpenAI (set AI_PROVIDER=openai, get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (set AI_PROVIDER=claude, get key from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-claude-api-key
CLAUDE_MODEL=claude-3-haiku-20240307

# ============================================
# NSE FINANCIAL STATEMENT PDF PARSING
# ============================================
# Python interpreter path (Dockerfile sets this to python3)
# PYTHON_PATH=python3

# Public backend URL for webhook callbacks from Python parser
# Only needed if the Python process is on a different host than the Node server
# BACKEND_URL=https://your-app.railway.app

# OpenAI fallback for PDF parsing (optional — regex extraction works without it)
# When set, GPT-4o-mini will be used when regex finds fewer than 2 key metrics
# Uses OPENAI_API_KEY and OPENAI_MODEL from the AI section above

# Custom OpenAI-compatible API endpoint (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# WHATSAPP / TWILIO CONFIGURATION
# ============================================
# Provider: 'twilio', 'meta', or 'log' (for testing without real API)
WHATSAPP_PROVIDER=log

# Twilio (recommended for sandbox testing)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta Cloud API (alternative)
# META_PHONE_NUMBER_ID=your_phone_number_id
# META_ACCESS_TOKEN=your_access_token
# WHATSAPP_VERIFY_TOKEN=leadai_verify_2026

# ============================================
# SECURITY (Optional - for future use)
# ============================================
# JWT_SECRET=your-jwt-secret-key-here
# API_RATE_LIMIT=100
# API_KEY=your-api-key-here

# ============================================
# CLOUDFLARE TURNSTILE (Free CAPTCHA alternative)
# ============================================
# Get keys from: https://dash.cloudflare.com → Turnstile → Create site
# Site key goes in frontend .env as VITE_TURNSTILE_SITE_KEY
# Secret key goes here (backend only, never exposed to client)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ============================================
# LOGGING (Optional)
# ============================================
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

# ============================================
# ============================================
# ALPHA VANTAGE CONFIGURATION (ETF data fallback)
# ============================================
# Free API key from https://www.alphavantage.co/support/#api-key
# 5 calls/min, 500 calls/day limit.
# BATCH_STOCK_QUOTES returns all 27 USD ETFs in a single call.
# ALPHA_VANTAGE_API_KEY=

# ============================================
# YAHOO FINANCE PROXY CONFIGURATION
# ============================================
# Comma-separated list of proxy URLs for fetching Yahoo Finance data.
# Required when deploying on cloud platforms (Render, Railway, Vercel, AWS, GCP, Azure)
# because Yahoo blocks cloud IP ranges.
#
# Formats supported:
#   http://host:port
#   http://user:pass@host:port
#   https://host:port
#   socks5://host:port
#
# Example — free proxies (unreliable, for testing only):
# YAHOO_PROXY_LIST=http://12.34.56.78:8080,http://23.45.67.89:3128
#
# Example — residential proxy service (recommended for production):
# YAHOO_PROXY_LIST=http://your-residential-provider:auth_token@residential.country.zone:10000
#
# Leave empty to fall back to public CORS relays and direct connections
# (may work from local dev but will likely fail from cloud hosts).
# YAHOO_PROXY_LIST=

# ============================================
# REDIS CACHE CONFIGURATION (Optional)
# ============================================
# Redis URL for distributed caching of Yahoo Finance responses.
# Drastically reduces API calls when multiple server instances are running.
# Set REDIS_CACHE_ENABLED=true to enable. Supported by Railway, Render, and Redis Cloud.
# REDIS_URL=redis://default:password@host:port
# REDIS_CACHE_ENABLED=false

# ============================================
# PAYMENT PROVIDERS
# ============================================
# --- NowPayments (crypto, no business license required for individuals) ---
# Create an account at https://nowpayments.io and generate an API key.
# Set the IPN secret key in the NowPayments dashboard; the webhook posts to
# /api/payments/crypto-webhook on your backend.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional: override the API base URL (defaults to https://api.nowpayments.io/v1)
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# BACKEND_URL=https://your-backend.railway.app

# --- Pesapal (cards + M-Pesa — Kenyan gateway, individuals/sole proprietors) ---
# Register at https://pesapal.com (or the merchant dashboard). Create an
# application to get the consumer key/secret.
# In the Pesapal dashboard, register an IPN/notification URL pointing to
#   https://your-backend.railway.app/api/payments/pesapal-ipn
# and paste the generated IPN id below (or let the app auto-register it).
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox        # set to 'production' when going live
# PESAPAL_IPN_ID=          # optional; auto-registered if omitted
# PESAPAL_IPN_URL=https://your-backend.railway.app/api/payments/pesapal-ipn
# FRONTEND_URL=https://your-frontend.vercel.app
# BACKEND_URL=https://your-backend.railway.app

# --- PayPal (card / PayPal balance) ---
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=live            # or 'sandbox' for testing
# PAYPAL_RETURN_URL=https://your-backend.railway.app
# PAYPAL_WEBHOOK_ID=         # required for webhook event verification

# --- PayHero (M-Pesa STK push) ---
# PAYHERO_AUTH_TOKEN=
# PAYHERO_CHANNEL_ID=
# PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
# PAYHERO_CALLBACK_URL=https://your-backend.railway.app
