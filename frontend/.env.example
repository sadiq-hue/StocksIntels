# Backend API URL - not needed for dev (Vite proxy handles /api -> backend)
# Set this in production only if NOT using Vercel rewrites:
# VITE_API_URL=https://your-backend.com/api

# Google OAuth Client ID for Sign-In
# Get one at: https://console.cloud.google.com/apis/credentials
# Add your Vercel preview/production URLs as Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudflare Turnstile (free CAPTCHA alternative)
# Get keys from: https://dash.cloudflare.com → Turnstile → Create site
# Action: Managed or Non-interactive recommended
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Meta (Facebook) Pixel for Meta Ads tracking & conversion optimization
# Get your Pixel ID from: https://business.facebook.com/events_manager
# Events Manager → Data Sources → Your Pixel → Pixel ID (16-digit number)
# Leave unset to disable all Meta Pixel tracking.
VITE_META_PIXEL_ID=your_meta_pixel_id_here

# Frontend market data / news API keys (set in Vercel dashboard, not here)
# VITE_NEWSAPI_KEY=your_newsapi_key_here
# VITE_FINNHUB_KEY=your_finnhub_key_here
# VITE_POLYGON_API_KEY=your_polygon_key_here
# VITE_BENZINGA_API_KEY=your_benzinga_key_here
