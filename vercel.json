{
  "rootDirectory": "frontend",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://stockintel-backend-production.up.railway.app/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "https://stockintel-backend-production.up.railway.app/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
